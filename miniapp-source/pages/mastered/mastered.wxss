#page-root[data-page="pages/mastered/mastered"] { min-height: 100%; }
.intro { background: #edf7f2; }
.group { display: flex; align-items: center; justify-content: space-between; }
.name { font-size: calc(31 * var(--rpx)); font-weight: 700; }
.arrow { font-size: calc(46 * var(--rpx)); color: #8aa0aa; }
.mastered-page { width: 100%; padding: 0 calc(24 * var(--rpx)) calc(36 * var(--rpx)); }
.mastered-sticky { position: sticky; top: 0; z-index: 8; margin: 0 calc(-24 * var(--rpx)); padding: calc(18 * var(--rpx)) calc(24 * var(--rpx)) calc(16 * var(--rpx)); background: rgba(246,249,252,.96); backdrop-filter: blur(18px); border-bottom: calc(2 * var(--rpx)) solid rgba(104,125,165,.1); }
.mastered-search-row { display: flex; align-items: center; gap: calc(12 * var(--rpx)); }
.mastered-search { flex: 1; min-width: 0; }
.mastered-count { flex: none; color: #687b95; font-size: calc(24 * var(--rpx)); }
.filter-row, .batch-row { margin-top: calc(12 * var(--rpx)); display: flex; gap: calc(10 * var(--rpx)); overflow-x: auto; }
.filter-picker { flex: none; max-width: 44%; }
.filter-chip, .batch-btn { min-height: calc(58 * var(--rpx)); padding: 0 calc(18 * var(--rpx)); border-radius: calc(999 * var(--rpx)); background: #edf1f8; color: #4e6182; font-size: calc(23 * var(--rpx)); line-height: calc(58 * var(--rpx)); white-space: nowrap; }
.batch-btn { margin: 0; border: calc(2 * var(--rpx)) solid rgba(108,128,170,.14); }
.batch-btn.danger { color: #a43c36; background: #fff0ee; }
.mastered-list { margin-top: calc(20 * var(--rpx)); }
.mastered-item { padding: calc(24 * var(--rpx)); }
.selected-item { border-color: rgba(82,108,170,.55); background: #f3f6ff; }
.item-head { display: flex; align-items: center; justify-content: space-between; gap: calc(12 * var(--rpx)); }
.mastered-tags { display: flex; flex-wrap: wrap; gap: calc(8 * var(--rpx)); }
.mastered-tags .tag { margin: 0; }
.select-dot { flex: none; width: calc(42 * var(--rpx)); height: calc(42 * var(--rpx)); border-radius: 50%; border: calc(2 * var(--rpx)) solid #aab5c7; display: grid; place-items: center; color: #fff; }
.select-dot.checked { background: #526caa; border-color: #526caa; }
.mastered-question { margin-top: calc(18 * var(--rpx)); color: #263a58; font-size: calc(30 * var(--rpx)); font-weight: 700; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.mastered-order { margin-top: calc(12 * var(--rpx)); color: #7a8799; font-size: calc(23 * var(--rpx)); }
.restore-btn { width: 100%; margin-top: calc(20 * var(--rpx)); min-height: calc(72 * var(--rpx)); border-radius: calc(14 * var(--rpx)); background: rgba(239,244,250,.95); color: #526caa; border: calc(2 * var(--rpx)) solid rgba(118,145,199,.16); }
