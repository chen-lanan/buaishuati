/* v1.7.3：单选/判断保持圆形，多选改为圆角方形；仅轻微增强边框。 */
#page-root[data-page="pages/practice/practice"] .option-key {
  border: calc(2 * var(--rpx)) solid rgba(151, 164, 192, .30) !important;
  box-shadow: inset 0 0 0 calc(1 * var(--rpx)) rgba(255, 255, 255, .045);
}
#page-root[data-page="pages/practice/practice"] .single-choice .option-key {
  border-radius: 50% !important;
}
#page-root[data-page="pages/practice/practice"] .multiple-choice .option-key {
  border-radius: calc(10 * var(--rpx)) !important;
}
#page-root[data-page="pages/practice/practice"] .option.selected .option-key,
#page-root[data-page="pages/practice/practice"] .option.correct .option-key,
#page-root[data-page="pages/practice/practice"] .option.wrong .option-key {
  border-color: rgba(255, 255, 255, .24) !important;
}

/* v1.7.4：图片题按选项分别显示，隐藏无信息量的“图形”占位文字。 */
#page-root[data-page="pages/practice/practice"] .question-image {
  display: block;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 52vh;
  margin-left: auto;
  margin-right: auto;
  object-fit: contain;
  background: #fff;
  padding: calc(6 * var(--rpx));
  box-sizing: border-box;
}
#page-root[data-page="pages/practice/practice"] .visual-option {
  align-items: center;
  min-height: calc(170 * var(--rpx));
}
#page-root[data-page="pages/practice/practice"] .visual-option .option-content {
  align-items: center;
  justify-content: center;
}
#page-root[data-page="pages/practice/practice"] .visual-option .option-image {
  display: block;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: calc(240 * var(--rpx));
  margin: 0 auto;
  object-fit: contain;
  background: #fff;
  border-radius: calc(10 * var(--rpx));
  padding: calc(6 * var(--rpx));
  box-sizing: border-box;
}


/* v1.7.5：所有带图片选项统一按原始比例显示，文字存在时也禁止放大低分辨率图片。 */
#page-root[data-page="pages/practice/practice"] .image-option .option-content {
  width: 100%;
  align-items: flex-start;
}
#page-root[data-page="pages/practice/practice"] .image-option .option-image,
#page-root[data-page="pages/practice/practice"] .visual-option .option-image {
  display: block;
  width: auto !important;
  height: auto !important;
  max-width: 100% !important;
  max-height: calc(280 * var(--rpx)) !important;
  align-self: center;
  margin: calc(4 * var(--rpx)) auto 0;
  object-fit: contain;
  background: #fff;
  border-radius: calc(10 * var(--rpx));
  padding: calc(6 * var(--rpx));
  box-sizing: border-box;
}
#page-root[data-page="pages/practice/practice"] .image-option .option-text {
  width: 100%;
  padding-right: calc(4 * var(--rpx));
}
#page-root[data-page="pages/practice/practice"] .answer-image {
  width: auto !important;
  height: auto !important;
  max-width: 100% !important;
  max-height: calc(560 * var(--rpx));
  margin: calc(10 * var(--rpx)) auto 0;
  object-fit: contain;
  background: #fff;
  padding: calc(6 * var(--rpx));
  box-sizing: border-box;
}

#page-root[data-page="pages/practice/practice"] .analysis-image {
  display:block; width:auto !important; height:auto !important; max-width:100% !important; max-height:calc(560 * var(--rpx)); margin:calc(10 * var(--rpx)) auto 0; object-fit:contain; background:#fff; padding:calc(6 * var(--rpx)); box-sizing:border-box; border-radius:calc(10 * var(--rpx));
}

/* v1.8.5：答题卡状态与题型可叠加筛选；底色表示作答状态，莫奈色粗边框表示题型。 */
.practice-sheet-summary .sheet-summary-item { cursor: pointer; border: calc(2 * var(--rpx)) solid transparent; }
.practice-sheet-summary .sheet-summary-item.filter-active {
  border-color: rgba(255,255,255,.78);
  box-shadow: 0 0 0 calc(3 * var(--rpx)) rgba(255,255,255,.12);
}
.practice-sheet-type-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(12 * var(--rpx));
  margin: 0 0 calc(12 * var(--rpx));
  font-size: calc(22 * var(--rpx));
  font-weight: 750;
}
.practice-sheet-filter-count { color: #909098; font-size: calc(20 * var(--rpx)); font-weight: 500; }
.practice-sheet-type-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: calc(10 * var(--rpx));
  margin-bottom: calc(14 * var(--rpx));
}
.practice-sheet-type-item {
  --sheet-type-color: #7c9ae6;
  min-width: 0;
  min-height: calc(58 * var(--rpx));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(7 * var(--rpx)) calc(5 * var(--rpx));
  border: calc(4 * var(--rpx)) solid var(--sheet-type-color);
  border-radius: calc(12 * var(--rpx));
  background: rgba(255,255,255,.035);
  color: #dedee6;
  font-size: calc(20 * var(--rpx));
  font-weight: 750;
  line-height: 1.15;
  text-align: center;
  word-break: keep-all;
}
.practice-sheet-type-item.filter-active {
  background: rgba(114, 80, 142, .20);
  box-shadow: 0 0 0 calc(3 * var(--rpx)) rgba(193, 130, 233, .18);
}
.practice-sheet-filter-note {
  flex: none;
  margin: 0 0 calc(12 * var(--rpx));
  padding: calc(8 * var(--rpx));
  border-radius: calc(10 * var(--rpx));
  background: rgba(118, 105, 145, .16);
  color: #c8b8e6;
  font-size: calc(20 * var(--rpx));
  text-align: center;
}
.practice-sheet-empty {
  padding: calc(70 * var(--rpx)) calc(20 * var(--rpx));
  color: #8f8f98;
  text-align: center;
  font-size: calc(22 * var(--rpx));
}
.practice-sheet-number {
  --sheet-type-color: #7c9ae6;
  border-width: calc(4 * var(--rpx));
  border-color: var(--sheet-type-color);
}
.practice-sheet-number.sheet-current { border-color: var(--sheet-type-color); box-shadow: none; outline: none; }
.practice-sheet-current-note {
  margin: calc(-2 * var(--rpx)) 0 calc(10 * var(--rpx));
  color: #c8b8e6;
  font-size: calc(19 * var(--rpx));
  text-align: center;
}
.sheet-type-single { --sheet-type-color: #7c9ae6; }
.sheet-type-multiple { --sheet-type-color: #b487e8; }
.sheet-type-judge { --sheet-type-color: #e3b55d; }
.sheet-type-fill { --sheet-type-color: #5dbcd2; }
.sheet-type-short { --sheet-type-color: #d987b5; }
.sheet-type-calc { --sheet-type-color: #e08a5b; }
.sheet-type-drawing { --sheet-type-color: #8c9ddf; }
.sheet-type-other-0 { --sheet-type-color: #c68bd6; }
.sheet-type-other-1 { --sheet-type-color: #6fa6dc; }
.sheet-type-other-2 { --sheet-type-color: #d5a06d; }

@media (max-width: 360px) {
  .practice-sheet-type-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}



/* v2.0.1：材料题公共题干。材料随子题显示，但不重复写入题干正文。 */
.material-card { margin: 0 0 calc(16 * var(--rpx)); padding: calc(16 * var(--rpx)) calc(18 * var(--rpx)); border-radius: calc(14 * var(--rpx)); background: var(--theme-surface-high, rgba(127,127,127,.07)); border: calc(2 * var(--rpx)) solid var(--theme-card-border, rgba(128,128,128,.18)); }
.material-label { margin-bottom: calc(8 * var(--rpx)); color: var(--theme-accent, #405b9c); font-size: calc(22 * var(--rpx)); font-weight: 800; }
.material-text { color: var(--theme-text, inherit); font-size: .92em; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }

.material-image { display:block; max-width:100%; margin: calc(10 * var(--rpx)) auto 0; border-radius: calc(10 * var(--rpx)); }
