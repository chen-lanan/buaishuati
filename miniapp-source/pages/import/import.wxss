.upload-box { margin-top: calc(30 * var(--rpx)); min-height: calc(260 * var(--rpx)); border: calc(3 * var(--rpx)) dashed #84bfc6; border-radius: calc(22 * var(--rpx)); background: #f4fbfb; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: calc(26 * var(--rpx)); text-align: center; }
