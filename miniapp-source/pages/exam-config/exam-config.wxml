<view class="container safe-bottom" wx:if="{{manifest}}">
  <view class="card exam-head">
    <view class="title">模拟考试</view>
    <view class="subtitle">{{manifest.name}} · 系统随机抽题，交卷后统一显示结果。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">题目数量</view>
      <picker range="{{countLabels}}" value="{{countIndex}}" bindchange="onCountChange">
        <view class="picker-box">{{countLabels[countIndex]}} ›</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">考试时长</view>
      <picker range="{{durationLabels}}" value="{{durationIndex}}" bindchange="onDurationChange">
        <view class="picker-box">{{durationLabels[durationIndex]}} ›</view>
      </picker>
    </view>

    <view class="row-between switch-row">
      <view>
        <view class="label">包含简答题</view>
        <view class="subtitle">简答题不自动计分，交卷后显示参考答案。</view>
      </view>
      <switch checked="{{includeShort}}" color="#176B87" bindchange="onIncludeShort" />
    </view>
  </view>

  <view class="card rule">
    <view class="label">考试规则</view>
    <view class="subtitle">考试中不会显示正确答案；到时自动交卷；可通过上一题、下一题修改答案。</view>
  </view>

  <button class="btn-primary" bindtap="start">开始考试</button>
</view>
