.count-total { text-align: center; font-size: calc(88 * var(--rpx)); font-weight: 800; color: #176b87; margin-top: calc(28 * var(--rpx)); }
.count-label { text-align: center; color: #71838c; }
.counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(14 * var(--rpx)); margin-top: calc(34 * var(--rpx)); }
.count-item { border-radius: calc(18 * var(--rpx)); padding: calc(22 * var(--rpx)) calc(10 * var(--rpx)); display: flex; flex-direction: column; align-items: center; font-size: calc(24 * var(--rpx)); }
.count-number { font-size: calc(38 * var(--rpx)); font-weight: 800; margin-bottom: calc(4 * var(--rpx)); }
.normal { background: #eaf8f1; color: #117052; }
.warn { background: #fff5df; color: #9a5d00; }
.err { background: #fff0f0; color: #b42318; }
.field-label { font-weight: 700; margin-bottom: calc(16 * var(--rpx)); }
.warning-card { border: calc(2 * var(--rpx)) solid #f0d59a; }
.warning-title { font-size: calc(31 * var(--rpx)); font-weight: 700; color: #8e5700; }
.review-btn { margin-top: calc(24 * var(--rpx)); }
.main-btn, .cancel-btn { margin-top: calc(18 * var(--rpx)); }
.diagnostic-card { border-left: calc(8 * var(--rpx)) solid #176b87; }
.diagnostic-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: calc(14 * var(--rpx)); margin: calc(18 * var(--rpx)) 0; }
.diagnostic-grid > view { background: #f3f8f9; border-radius: calc(14 * var(--rpx)); padding: calc(20 * var(--rpx)) calc(12 * var(--rpx)); display: flex; flex-direction: column; align-items: center; text-align: center; color: #657982; font-size: calc(23 * var(--rpx)); }
.diag-number { font-size: calc(38 * var(--rpx)); font-weight: 800; color: #176b87; margin-bottom: calc(6 * var(--rpx)); }

.count-item { cursor: pointer; }
.count-tip { margin-top: calc(20 * var(--rpx)); text-align: center; color: #71838c; font-size: calc(23 * var(--rpx)); line-height: 1.5; }

.parse-mode-tag { display: inline-flex; margin-top: calc(14 * var(--rpx)); padding: calc(8 * var(--rpx)) calc(14 * var(--rpx)); border-radius: calc(999 * var(--rpx)); font-size: calc(23 * var(--rpx)); }
.parse-mode-tag.rule { background: #eef3fb; color: #536f9e; }
.parse-mode-tag.ai { background: #e9f7f1; color: #28775f; }

.replace-notice { border-color: rgba(208,159,61,.25); background: #fff8e7; }


.count-audit-card { border-left: calc(8 * var(--rpx)) solid #2f6f83; }
.audit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(14 * var(--rpx)); margin-top: calc(16 * var(--rpx)); }
.audit-grid > view { min-width: 0; padding: calc(18 * var(--rpx)) calc(10 * var(--rpx)); border-radius: calc(15 * var(--rpx)); background: #f2f7f9; display: flex; flex-direction: column; align-items: center; text-align: center; color: #637984; font-size: calc(22 * var(--rpx)); line-height: 1.45; }
.audit-number { margin-bottom: calc(5 * var(--rpx)); color: #176b87; font-size: calc(37 * var(--rpx)); font-weight: 800; font-variant-numeric: tabular-nums; }
.error-number { color: #b42318; }
.audit-explain { margin-top: calc(18 * var(--rpx)); padding: calc(16 * var(--rpx)); border-radius: calc(13 * var(--rpx)); background: #eef5f7; color: #607783; font-size: calc(23 * var(--rpx)); line-height: 1.65; }
.expected-card { border: calc(2 * var(--rpx)) solid rgba(23,107,135,.14); }
.expected-input { font-variant-numeric: tabular-nums; }
.expected-result { margin-top: calc(14 * var(--rpx)); padding: calc(14 * var(--rpx)) calc(16 * var(--rpx)); border-radius: calc(13 * var(--rpx)); background: #fff0e2; color: #9a5200; font-weight: 750; text-align: center; }
.expected-result.matched { background: #eaf8f1; color: #117052; }

.audit-detail-btn { width: 100%; margin-top: calc(16 * var(--rpx)); }
.audit-details { margin-top: calc(16 * var(--rpx)); }
.audit-detail-group { margin-top: calc(14 * var(--rpx)); padding: calc(16 * var(--rpx)); border-radius: calc(14 * var(--rpx)); background: #f7f9fa; border: calc(2 * var(--rpx)) solid #e3eaed; }
.audit-detail-title { margin-bottom: calc(10 * var(--rpx)); color: #3f5965; font-weight: 750; font-size: calc(24 * var(--rpx)); }
.audit-fragment { margin-top: calc(8 * var(--rpx)); color: #6a7e87; font-size: calc(22 * var(--rpx)); line-height: 1.6; white-space: pre-wrap; word-break: break-all; overflow-wrap: anywhere; }

.parser-route-tag { display: inline-flex; margin: calc(10 * var(--rpx)) 0 0 calc(8 * var(--rpx)); padding: calc(8 * var(--rpx)) calc(14 * var(--rpx)); border-radius: calc(999 * var(--rpx)); font-size: calc(22 * var(--rpx)); background: rgba(91,71,135,.12); color: #654c8b; }
